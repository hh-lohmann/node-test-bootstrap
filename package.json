{
  "name": "node-test-bootstrap",
  "description": "Bootstrapping for Node test runner files incl. bailing",
  "keywords": [],
  "author": {
    "name": "hh lohmann",
    "email": "hh.lohmann@gmail.com"
  },
  "version": "1.4.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hh-lohmann/node-test-bootstrap.git"
  },
  "bugs": "https://github.com/hh-lohmann/node-test-bootstrap/issues",
  "homepage": "https://hh-lohmann.github.io/node-test-bootstrap",
  "engines": { "node": ">=22.20.0" },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./bail": "./reporters-bail.js"
  },
  "dependencies": {
    "@reporters/bail": "^2.0.3"
  },
  "scripts": {
    "test": "node --test ./tests/**/*.test.*"
  },
  "commits-to-changelog": {
    "filterDefaults": false,
    "filterCommits": [  "/^bump version$/i", "/^changelog$/i", "/commits-to-changelog/", "/^dev:/i", "/^[Hh]ousekeeping/i", "/^planning/i", "/[Rr]efactoring/i", "/^tests/i"],
    "linesToReadme": 5
  }
}
